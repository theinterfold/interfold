scripts/blueprint/out/

# Local secrets. A `.env` file can hold deployment keys and machine-specific paths.
# Committing one publishes them.
# The agent permission files deny reads of these paths, but a denied read does not stop `git add`,
# so the per-environment variants are ignored here too.
.env
.env.local
.env.*.local
