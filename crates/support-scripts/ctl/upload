#!/usr/bin/env bash

# Configuration normally arrives through the environment so the Pinata token does not appear in
# process arguments. Keep the flags for direct, backwards-compatible use.
while [[ $# -gt 0 ]]; do
  case $1 in
    --pinata-jwt)
      PINATA_JWT="$2"
      shift 2
      ;;
    --ipfs-gateway-url)
      IPFS_GATEWAY_URL="$2"
      shift 2
      ;;
    *)
      echo "Unknown argument: $1"
      exit 1
      ;;
  esac
done

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONTAINER_ARGS=("./scripts/container/upload.sh")
export PINATA_JWT IPFS_GATEWAY_URL

exec "$SCRIPT_DIR/container" "${CONTAINER_ARGS[@]}"
