{
  "version": "0.10.0",
  "upstreamVersion": "0.19.0",
  "upstreamArg": "UPSTREAM_VERSION",
  "upstreamRepo": "theinterfold/interfold",
  "shortDescription": "Interfold ciphernode with setup and monitoring",
  "description": "Run an Interfold ciphernode. Use the remote Operator Dashboard to register your operator, bond FOLD, and buy tickets. Open the local Node dashboard to check its status.",
  "type": "service",
  "mainService": "ciphernode",
  "author": "Gnosis Guild <https://github.com/gnosisguild>",
  "categories": ["Blockchain", "Developer tools"],
  "keywords": ["interfold", "fhe", "mpc", "ciphernode", "threshold", "encryption"],
  "links": {
    "homepage": "https://www.theinterfold.com",
    "docs": "https://docs.theinterfold.com",
    "repository": "https://github.com/theinterfold/interfold"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/theinterfold/interfold.git",
    "directory": "dappnode"
  },
  "bugs": {
    "url": "https://github.com/theinterfold/interfold/issues"
  },
  "license": "LGPL-3.0-only",
  "requirements": {
    "minimumDappnodeVersion": "0.2.50"
  },
  "backup": [
    {
      "name": "configuration",
      "path": "/data/config.yaml",
      "service": "ciphernode"
    },
    {
      "name": "credentials",
      "path": "/data/.interfold/config",
      "service": "ciphernode"
    },
    {
      "name": "node-state",
      "path": "/data/.interfold/data",
      "service": "ciphernode"
    }
  ],
  "dockerTimeout": "90s"
}
