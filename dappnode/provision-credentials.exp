#!/usr/bin/expect -f
# Feed credentials to the hidden interactive prompts exposed by Interfold
# the Ciphernode CLI. Secrets arrive as base64-encoded lines on stdin; neither the
# plaintext nor the encoded value is placed in argv or the environment.

set timeout 30

proc fail {message {code 1}} {
    puts stderr "credential provisioning failed: $message"
    exit $code
}

proc read_secret {description} {
    if {[gets stdin encoded] < 0 || $encoded eq ""} {
        fail "$description was not provided on stdin"
    }
    if {[catch {binary decode base64 $encoded} decoded]} {
        fail "$description was not valid base64"
    }
    return $decoded
}

proc finish_child {description} {
    expect {
        eof {}
        timeout { fail "$description timed out" 124 }
    }
    set status [wait]
    if {[lindex $status 2] != 0} {
        fail "$description could not be reaped"
    }
    set exit_code [lindex $status 3]
    if {$exit_code != 0} {
        fail "$description exited with status $exit_code" $exit_code
    }
}

proc fail_on_early_exit {description} {
    set status [wait]
    if {[lindex $status 2] == 0} {
        set exit_code [lindex $status 3]
        if {$exit_code == 0} {
            set exit_code 1
        }
        fail "$description exited before prompting (status $exit_code)" $exit_code
    }
    fail "$description exited before prompting"
}

proc send_at_prompt {pattern secret description} {
    expect {
        -re $pattern { send -- "$secret\r" }
        timeout { fail "timed out waiting for $description prompt" 124 }
        eof { fail_on_early_exit "$description command" }
    }
}

if {$argc != 1} {
    fail "expected CONFIG_FILE"
}
set config_file [lindex $argv 0]

set password [read_secret "password"]
set private_key [read_secret "wallet private key"]

spawn -noecho interfold password set --config $config_file
send_at_prompt {Please enter a new password} $password "new password"
send_at_prompt {Please confirm your password} $password "password confirmation"
finish_child "password command"
unset password

spawn -noecho interfold wallet set --config $config_file
send_at_prompt {Enter your Ethereum private key} $private_key "wallet private key"
finish_child "wallet command"
unset private_key
