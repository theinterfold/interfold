#!/usr/bin/env sh

# git passes the pushed refs on stdin. Read them before a check can consume them. A manual run from
# a terminal has none.
[ -t 0 ] || pushed_refs="$(cat)"

pnpm lint
pnpm check:pnpm
pnpm check:license
pnpm check:committee
pnpm check:addresses
pnpm check:invariants
pnpm generate:verifiers --preset insecure --committee minimum --on-chain --check --no-compile
