#!/usr/bin/env sh

# git passes the pushed refs on stdin. Read them before a check can consume them. A manual run from
# a terminal has none.
[ -t 0 ] || pushed_refs="$(cat)"

pnpm lint
pnpm check:pnpm
pnpm check:license
pnpm check:crypto-config
pnpm check:addresses
pnpm check:repository
pnpm check:links

# The existing verifier check recompiles the selected aggregators. Exhaustive matrix qualification
# is explicit release/review work, not a pre-push prerequisite. The check reads
# the checked-out tree, so the helper stops the push (exit 2) of a branch that differs from HEAD in
# those paths. husky runs this hook with `sh -e`, so `||` keeps the helper's exit status.
status=0
printf '%s\n' "${pushed_refs:-}" | scripts/hooks/pushed-paths-match.sh .github/filters/circuits.yml || status=$?
case "$status" in
  0) pnpm check:verifiers ;;
  1) ;;
  *) exit "$status" ;;
esac
