# Network selector — picks the deployment profile (chain, RPC, addresses,
# explorer, fee token, deploy block, timeout windows) from src/lib/chain.ts.
# Supported: sepolia (default), mainnet.
# VITE_NETWORK=sepolia

# Every value below is optional and overrides the selected network's profile,
# so the dashboard can point at a custom deployment without code changes.

# RPC endpoint. Defaults to a public node for the selected network; use a
# dedicated provider (Alchemy/Infura) for production to avoid rate limits.
# VITE_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/<your-key>

# Contract addresses.
# Sepolia defaults:
#   VITE_INTERFOLD_ADDRESS=0xc5DD9418A0aBF15678F974D2348B4be4D3832B54
#   VITE_CIPHERNODE_REGISTRY_ADDRESS=0xfa0fCE6afd9b59E2Ac69DC53A128ee5835346B5e
#   VITE_CRISP_PROGRAM_ADDRESS=0x9Dc6edB343A89a25dC8bEF324F721Cca78E86AFD
# Mainnet defaults:
#   VITE_INTERFOLD_ADDRESS=0x28cF63B459e6218C69EA97ea7D90541cf648c715
#   VITE_CIPHERNODE_REGISTRY_ADDRESS=0xC927A5B2d8F68697bC28C0670df05178c93df2d7
#   VITE_CRISP_PROGRAM_ADDRESS=0x53FCdb21E73A461CfE6c64B19855204384B91BA3

# Bonding registry backing the "Run a ciphernode" guide. The ciphernode bond token,
# ticket wrapper, and ticket underlying are read back from this contract, so
# this is the only address the guide needs.
# Sepolia: 0x55Cf62396e1CAE6Fcc380CfE0b4C48103C4a3711
# Mainnet: 0x0ec90465095C21830BEcED07e032809A2Bd2915F
# VITE_BONDING_REGISTRY_ADDRESS=

# Testnet faucet (FOLD + fee token). Sepolia has a faucet by default:
# 0xA7f0A637Af62fA4E0b46E397D1b85E9b4807f019. Mainnet has none. Set this to a faucet
# contract address to show the "Get test tokens" action. It shows only on a test
# network. An empty value or the zero address hides it.
# VITE_FAUCET_ADDRESS=

# Fee token metadata used to format escrowed fees/rewards.
# Sepolia: USDC / 6 (MockUSDC, a test token that anyone can mint). Mainnet: USDS / 18.
# VITE_FEE_TOKEN_SYMBOL=USDC
# VITE_FEE_TOKEN_DECIMALS=6

# First block to scan from. It bounds getLogs against Interfold,
# CiphernodeRegistry and CRISPProgram, so set it to the earliest of those three
# deploy blocks — a later value silently drops earlier registry events.
# Lower = slower initial load (more getLogs chunks).
# Sepolia: 11855915. Mainnet: 25786403.
# VITE_DEPLOY_BLOCK=

# E3 timeout windows (seconds), from the deployment's getTimeoutConfig(). Used to
# decide whether an E3 is still active vs. expired (input close + these windows).
# Sepolia: 604800 / 21600. Mainnet: 604800 / 21600.
# VITE_COMPUTE_WINDOW=
# VITE_DECRYPTION_WINDOW=
