# Network selection. Each build contains every network profile in
# src/lib/networks.ts (chain, RPC, addresses, explorer, fee token, deploy block,
# timeout windows). The page picks one profile when it loads.
#
# VITE_NETWORK_HOSTS maps hostnames to networks as comma-separated host=network
# pairs. Use it to serve mainnet and testnet from one deployment on two domains.
# VITE_NETWORK_HOSTS=dashboard.theinterfold.com=mainnet,testnet.example.com=sepolia
#
# A hostname that is not in VITE_NETWORK_HOSTS (preview URLs, localhost) uses
# VITE_NETWORK. Supported: sepolia (default), mainnet.
# VITE_NETWORK=sepolia

# Every value below is optional and overrides one value of one network's profile.
# The name is VITE_<NETWORK>_<SETTING>, so an override for one network never
# applies to another. The build fails on an unscoped name such as VITE_RPC_URL.

# RPC endpoints. The defaults are public nodes; use a dedicated provider
# (Alchemy/Infura) for production to avoid rate limits.
# VITE_SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/<your-key>
# VITE_MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/<your-key>

# Contract addresses.
# Sepolia defaults:
#   VITE_SEPOLIA_INTERFOLD_ADDRESS=0xBD5B6D1aDA9e0eB248B678469C9Cd6a63507E42b
#   VITE_SEPOLIA_CIPHERNODE_REGISTRY_ADDRESS=0xb1E8640CF8D0A927290E3d9E1b01c4899B5225Ef
#   VITE_SEPOLIA_CRISP_PROGRAM_ADDRESS=0xA9894A39061EC33f8550a2B63A66Be59fb9fa443
# Mainnet defaults:
#   VITE_MAINNET_INTERFOLD_ADDRESS=0x28cF63B459e6218C69EA97ea7D90541cf648c715
#   VITE_MAINNET_CIPHERNODE_REGISTRY_ADDRESS=0xC927A5B2d8F68697bC28C0670df05178c93df2d7
#   VITE_MAINNET_CRISP_PROGRAM_ADDRESS=0x1EA4dBdec0F2F1E9235915847fc59EF4045EEe28

# Bonding registry backing the "Run a ciphernode" guide. The ciphernode bond token,
# ticket wrapper, and ticket underlying are read back from this contract, so
# this is the only address the guide needs.
# Sepolia: 0x8687bC7C8f055b41aD2C2447c04aCBD76C1075b2
# Mainnet: 0x0ec90465095C21830BEcED07e032809A2Bd2915F
# VITE_SEPOLIA_BONDING_REGISTRY_ADDRESS=
# VITE_MAINNET_BONDING_REGISTRY_ADDRESS=

# Testnet faucet (FOLD + fee token). Sepolia has a faucet by default:
# 0x1B4340A65BB669267BF5DE37385B139987C3F09c. Mainnet has none. Set this to a faucet
# contract address to show the "Get test tokens" action. It shows only on a test
# network. An empty value or the zero address hides it.
# VITE_SEPOLIA_FAUCET_ADDRESS=

# Fee token metadata used to format escrowed fees/rewards.
# Sepolia: USDC / 6 (MockUSDC, a test token that anyone can mint). Mainnet: USDS / 18.
# VITE_SEPOLIA_FEE_TOKEN_SYMBOL=USDC
# VITE_SEPOLIA_FEE_TOKEN_DECIMALS=6

# First block to scan from. It bounds getLogs against Interfold,
# CiphernodeRegistry and CRISPProgram, so set it to the earliest of those three
# deploy blocks — a later value silently drops earlier registry events.
# Lower = slower initial load (more getLogs chunks).
# Sepolia: 11873232. Mainnet: 25786403.
# VITE_SEPOLIA_DEPLOY_BLOCK=
# VITE_MAINNET_DEPLOY_BLOCK=

# E3 timeout windows (seconds), from the deployment's getTimeoutConfig(). Used to
# decide whether an E3 is still active vs. expired (input close + these windows).
# Sepolia: 604800 / 21600. Mainnet: 604800 / 21600.
# VITE_SEPOLIA_COMPUTE_WINDOW=
# VITE_SEPOLIA_DECRYPTION_WINDOW=
