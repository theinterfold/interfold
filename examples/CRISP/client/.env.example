VITE_INTERFOLD_API=http://127.0.0.1:4000
VITE_CHAIN_ID=31337
VITE_RPC_URL=http://127.0.0.1:8545
VITE_WALLETCONNECT_PROJECT_ID=
# Voting eligibility token (MockVotingToken). Updated automatically on `pnpm dev:up` deploy.
# Interfold fee token (MockUSDC) is separate: packages/interfold-contracts/deployed_contracts.json → MockUSDC.
VITE_CRISP_TOKEN=0x5081a39b8A5f0E35a8D959395a630b68B74Dd30f
# Addresses of requesters for which to show rounds in the UI. Comma separated Ethereum addresses.
VITE_E3_REQUESTERS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266,0x70997970C51812dc3A010C7d01b50e0d17dc79C8
# Set to "false" to hide the test-token faucet on test networks too. On mainnet it is always off.
VITE_ENABLE_TEST_TOKEN_MINT=true
# Set to "true" to submit votes from the voter's wallet instead of the server relay. On mainnet
# the relay is disabled and the direct path is always used.
VITE_DIRECT_VOTE=false
# The block CRISPProgram was deployed at on this chain, where the client starts scanning its logs to
# resolve a slot head. `pnpm dev:up` overwrites this with the local deployment's block. A deployed
# network must set its real deployment block: the scan cannot start at genesis, because hosted RPC
# providers refuse a `eth_getLogs` range that wide and nothing in a round's public state is a height.
VITE_CRISP_PROGRAM_DEPLOY_BLOCK=0
