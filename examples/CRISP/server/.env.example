# Private key for the interfold server
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# Use 127.0.0.1 (not 0.0.0.0) — program-server webhooks and CLI connect outbound to this URL.
