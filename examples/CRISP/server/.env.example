CHAIN_ID=31337

# Etherscan API key
ETHERSCAN_API_KEY=""

# Cron-job API key to trigger new rounds
CRON_API_KEY=1234567890 

# Interfold stack: updated automatically on each `pnpm dev:up` deploy (do not edit by hand unless debugging).
# Stale E3_PROGRAM_ADDRESS causes requestE3 to revert with empty data `0x`.
INTERFOLD_ADDRESS=0x0DCd1Bf9A1b36cE34237eEaFef220932846BCD82
FEE_TOKEN_ADDRESS=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512
E3_PROGRAM_ADDRESS=0xc351628EB244ec633d5f21fBD6621e1a683B1181
CIPHERNODE_REGISTRY_ADDRESS=0x5FC8d32690cc91D4c39d9d3abcBD16989F875707
# CRISP voting eligibility token (MockVotingToken) — NOT the fee token above
CRISP_VOTING_TOKEN=0x5081a39b8A5f0E35a8D959395a630b68B74Dd30f

# Mock contracts registered on Interfold during deploy (reference only)
MOCK_COMPUTE_PROVIDER_ADDRESS=0x5eb3Bc0a489C5A8288765d2336659EbCA68FCd00
MOCK_DECRYPTION_VERIFIER_ADDRESS=0x36C02dA8a0983159322a80FFE9F24b1acfF8B570
MOCK_PK_VERIFIER_ADDRESS=0x809d550fca64d94Bd9F66E60752A544199cfAC3D
MOCK_E3_PROGRAM_ADDRESS=0x4c5859f0F772848b2D91F1D83E2Fe57935348029

# E3 Config
# Local mock duration. In Avail mode, startup reads the current on-chain committee, voting, and
# finalization windows and requires E3_DURATION to cover their sum. Current production defaults
# require 40200 seconds; 43200 seconds (12 hours) adds operating margin.
E3_DURATION=300

# Large encrypted objects use a deterministic in-process mock on local chains. For Sepolia use
# `avail`, `https://turing-rpc.avail.so/http`, and `https://turing-bridge-api.avail.so`. For
# Ethereum mainnet use an HTTPS Avail RPC and `https://bridge-api.avail.so`.
DATA_AVAILABILITY_MODE=mock
AVAIL_RPC_URL=
AVAIL_BRIDGE_API_URL=
AVAIL_APP_ID=
AVAIL_PROOF_LEAD_SECONDS=10800
# Refuse new unfinished publications before they can fill the server disk. Default: 1 GiB.
DATA_AVAILABILITY_MAX_PENDING_BYTES=1073741824
# Avail secret URI for the server account that pays `submit_data`. Never commit a real value.
AVAIL_SEED=
# 0=InsecureThreshold512, 1=SecureThreshold8192
E3_PARAM_SET=0
# 0=Minimum, 1=Micro, 2=Small
E3_COMMITTEE_SIZE=0

# E3 Compute Provider Config
E3_COMPUTE_PROVIDER_NAME="RISC0"
E3_COMPUTE_PROVIDER_PARALLEL=false
E3_COMPUTE_PROVIDER_BATCH_SIZE=4 # Must be a power of 2

# Whether to enable proof aggregation for E3 programs.
# Managed by pnpm dev:setup from ../crisp.dev.env — edit that file, then re-run dev:setup.
# See ../docs/PROOF_AGGREGATION_AND_ZK.md.

# --- Indexing / chain access -----------------------------------------------------------
# Block to start indexing from on a FRESH database. Absent = start at the chain head, which is
# what this server did before backfill existed. Ignored once a cursor is stored: a restart always
# resumes from the cursor and replays exactly the gap it missed.
#
# READ THIS BEFORE SETTING IT. Backfill replays through the SAME handlers as live events, and the
# E3 handlers are not pure — `E3Requested` submits `setMerkleRoot` on chain. Setting this to a
# deployment block on a fresh database therefore re-runs those side effects for every historical
# round, not just rebuilds an index. Most of those transactions will revert as already-applied,
# but they cost gas and they are broadcast from the server key.
#
# Safe uses:
#   - Leave unset in normal operation. The log index then starts at first boot, and queries for
#     earlier blocks are forwarded upstream, which is correct if slower.
#   - Set it on a deliberately fresh database when you want history AND accept the replay, ideally
#     with the relay key drained first.
# INDEX_START_BLOCK=

# eth_getLogs window used for backfill. Lower it if the provider rejects the range.
# INDEX_CHUNK_SIZE=2000

# Comma-separated contracts the read-only /chain/* routes will serve. EMPTY DENIES EVERYTHING:
# a misconfigured deployment must fail closed rather than become an open RPC endpoint. List every
# contract the frontend reads (coordinator, CRISP program, registries, refund manager, tokens,
# faucet, plugins, SPPs, DAO).
# INDEX_CONTRACTS=0x...,0x...

# Subset of the above whose LOGS are indexed into the store. Serving reads for a contract is
# cheap; retaining every log it emits is not — a busy ERC-20 emits thousands of Transfers per
# thousand blocks, and nothing queries them. List only contracts whose event history is actually
# read (plugins, SPPs, registries). Empty = no log indexing; queries still work, just forwarded.
# INDEX_LOG_CONTRACTS=0x...,0x...
