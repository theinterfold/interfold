  /// @notice The sums `S_i` of the 8 groups of the 16 levels of the published plaintext.
  /// @param plaintext The published plaintext output: 128 little-endian `uint64` coefficients.
  function levelSums(bytes memory plaintext) internal pure returns (uint256[LEVELS] memory sums) {
    uint256[] memory coeffs = SlotCodec.coefficients(plaintext);
    bytes memory weights = WEIGHTS;
    for (uint256 i = 0; i < LEVELS; i++) {
      uint256 acc;
      assembly ("memory-safe") {
        let w := add(add(weights, 32), shl(8, i))
        let c := add(coeffs, 32)
        // At most 128 products below 257 * 257: the sum cannot overflow.
        for {
          let k := 0
        } lt(k, 128) {
          k := add(k, 1)
        } {
          acc := add(acc, mul(mload(add(c, shl(5, k))), shr(240, mload(add(w, shl(1, k))))))
        }
        acc := mod(acc, 257)
      }
      sums[i] = acc;
    }
  }

  /// @notice Reads the outcome from the published plaintext.
  /// @param plaintext The published plaintext output.
  /// @param levels The number of price levels of the negotiation.
  /// @return matched Whether a level was agreed.
  /// @return step The agreed level, 0 if there is no match.
  function decode(bytes memory plaintext, uint8 levels) internal pure returns (bool matched, uint8 step) {
    uint256[LEVELS] memory sums = levelSums(plaintext);
    for (uint256 i = 0; i < LEVELS; i++) {
      if (sums[i] == 0) continue;
      if (sums[i] != 1 || i >= levels || matched) revert InvalidOutput();
      matched = true;
      step = uint8(i);
    }
  }
