pragma solidity 0.8.28;

import { SlotCodec } from "./SlotCodec.sol";

/// @title Reader of the decrypted output of a negotiation.
/// @notice The output is one plaintext of 128 SIMD slots. Slot `g * 16 + i` is the group `g` (0 to 7) of
/// the level `i` (0 to 15). The sum of the 8 groups of a level is 0 or 1, and at most one level has the
/// sum 1: the level of the agreed price. All zero means that there is no match.
