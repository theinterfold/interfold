# Used by `docker build -f examples/negotiation/server/Dockerfile .` from the repository root.
.git
**/node_modules
**/target
**/.DS_Store
**/*.log
examples/negotiation/artifacts
examples/negotiation/cache
examples/negotiation/.interfold
examples/negotiation/guest
# Never send local secrets to an image.
**/.env
**/.env.*
!**/.env.example
