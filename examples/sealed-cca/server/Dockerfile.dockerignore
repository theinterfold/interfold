# Used by `docker build -f examples/sealed-cca/server/Dockerfile .` from the repository root.
.git
**/node_modules
**/target
**/.DS_Store
**/*.log
examples/sealed-cca/artifacts
examples/sealed-cca/cache
examples/sealed-cca/.interfold
examples/sealed-cca/guest
# Never send local secrets to an image.
**/.env
**/.env.*
!**/.env.example
