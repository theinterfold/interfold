# Sealed-Bid Auctions client. Vite reads this file as `.env` (copy it); every value is public in the
# built bundle, so never put a secret here.
#
# --- Required: contract addresses ------------------------------------------------------------
# Local: `pnpm dev:frontend` exports these from interfold.config.yaml
# (`interfold print-env --vite --chain localhost`), so no file is needed.
VITE_INTERFOLD_ADDRESS=
VITE_REGISTRY_ADDRESS=
VITE_E3_PROGRAM_ADDRESS=
VITE_FEE_TOKEN_ADDRESS=

# --- Network ---------------------------------------------------------------------------------
# Supported chains: 31337 (anvil, the default) and 11155111 (Sepolia).
VITE_CHAIN_ID=31337
# Read over HTTP; a ws:// or wss:// URL is accepted and read over http(s).
VITE_RPC_URL=http://127.0.0.1:8545
# Block the contracts were deployed in: every event scan starts here. 0 is fine on anvil, but on a
# public chain set the real block or each page load scans from genesis.
VITE_DEPLOY_BLOCK=0
# Blocks per eth_getLogs request. Public RPCs cap the range; 50000 is a safe default.
VITE_LOG_CHUNK_SIZE=50000

# --- Wallets ---------------------------------------------------------------------------------
# Optional: adds WalletConnect next to injected browser wallets.
VITE_WALLETCONNECT_PROJECT_ID=

# --- Test tokens (test deployments only) -----------------------------------------------------
# Address of a Faucet contract (`function faucet() external`). When set, an account that cannot pay
# the E3 fee gets a "Get test tokens" button that calls it.
VITE_FAUCET_ADDRESS=
# Without a faucet: show "Mint test fee tokens", which calls the fee token's public
# `mint(address,uint256)`. Always on for anvil.
VITE_ENABLE_TEST_TOKEN_MINT=false

# ================================================================================================
# Example: local anvil (what `pnpm dev:frontend` sets)
# ================================================================================================
# VITE_CHAIN_ID=31337
# VITE_RPC_URL=http://127.0.0.1:8545
# VITE_ENABLE_TEST_TOKEN_MINT=true
# (the four addresses come from `interfold print-env --vite --chain localhost`)

# ================================================================================================
# Example: Sepolia
# ================================================================================================
# VITE_CHAIN_ID=11155111
# VITE_RPC_URL=https://sepolia.example-rpc.io/<key>
# VITE_DEPLOY_BLOCK=<block of the E3 program deployment>
# VITE_LOG_CHUNK_SIZE=50000
# VITE_INTERFOLD_ADDRESS=0x...
# VITE_REGISTRY_ADDRESS=0x...
# VITE_E3_PROGRAM_ADDRESS=0x...
# VITE_FEE_TOKEN_ADDRESS=0x...
# VITE_FAUCET_ADDRESS=0x...
# VITE_WALLETCONNECT_PROJECT_ID=<reown project id>
