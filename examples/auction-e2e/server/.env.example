# Environment of the auction coordination server (server/index.ts).
# Copy the block that you need to `.env` or to your container environment. Never commit real keys.

# --- Local development (anvil, mock data availability) ---
# `pnpm dev:server` sets all of these. The addresses come from `interfold print-env --chain localhost`.
RPC_URL=http://localhost:8545
CHAIN_ID=31337
# The first anvil account. A public test key: never use it on a public chain.
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
INTERFOLD_ADDRESS=
REGISTRY_ADDRESS=
FEE_TOKEN_ADDRESS=
E3_PROGRAM_ADDRESS=
PORT=8080
PROGRAM_RUNNER_URL=http://127.0.0.1:13151
CALLBACK_URL=http://127.0.0.1:8080
DATA_AVAILABILITY_MODE=mock_http
DATA_DIRECTORY=.interfold/data-availability

# --- Sepolia (Avail data availability) ---
# RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Optional WebSocket endpoint for the live event listener. Without it the server polls RPC_URL.
# WS_RPC_URL=wss://ethereum-sepolia-rpc.publicnode.com
# CHAIN_ID=11155111
# The operator key. It sends publishCiphertextOutput and needs Sepolia ETH.
# PRIVATE_KEY=0x...
# The addresses of the Interfold protocol and of the deployed AuctionProgram.
# INTERFOLD_ADDRESS=0xBD5B6D1aDA9e0eB248B678469C9Cd6a63507E42b
# REGISTRY_ADDRESS=0xb1E8640CF8D0A927290E3d9E1b01c4899B5225Ef
# FEE_TOKEN_ADDRESS=0xE2e534F7Cb95777eD870CDCaCb80B1E9E2aD555B
# E3_PROGRAM_ADDRESS=
# The block of the AuctionProgram deployment (required on Sepolia): event scans start here.
# DEPLOY_BLOCK=
# The largest block range of one log request. Lower it when your RPC provider caps the range.
# LOG_CHUNK_SIZE=10000
# The program runner, and the base URL of this server that the runner can reach. The server adds
# `/callback/<e3Id>/<token>`: the token is random per run and is the only credential of the callback.
# In Docker, 127.0.0.1 is the container itself. Use the service name of the runner (here `runner`) or
# a host address, and the service name of the server (here `server`).
# PROGRAM_RUNNER_URL=http://runner:13151
# CALLBACK_URL=http://server:8080
# The runner refuses a callback URL with a private or loopback IP address unless it runs with
# ALLOW_PRIVATE_CALLBACKS=1. A service name or a public host name passes.
# DATA_AVAILABILITY_MODE=avail
# DATA_DIRECTORY=/data
# The Avail endpoints. Turing is the Avail testnet that the Sepolia VectorX bridge follows.
# AVAIL_RPC_URL=https://turing-rpc.avail.so/rpc
# AVAIL_BRIDGE_API_URL=https://turing-bridge-api.avail.so
# The Avail application ID that you created, and the secret URI of a funded Avail account.
# AVAIL_APP_ID=
# AVAIL_SEED=
# Seconds between two checks of the VectorX proof. The proof takes up to about three hours.
# AVAIL_PROOF_POLL_INTERVAL_SECONDS=60
# The Avail helper: `cargo build --release -p auction-da`, or /usr/local/bin/auction-da in the image.
# AUCTION_DA_BIN=./target/release/auction-da
