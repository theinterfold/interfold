{
  "name": "@interfold/main",
  "description": "Interfold is an open-source protocol for Encrypted Execution Environments (E3).",
  "version": "0.20.0-dev.2",
  "private": true,
  "license": "LGPL-3.0-only",
  "author": {
    "name": "gnosisguild",
    "url": "https://github.com/gnosisguild"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/theinterfold/interfold"
  },
  "scripts": {
    "bump:versions": "tsx scripts/release/bump.ts",
    "release:tag": "node scripts/release/index.mjs tag",
    "test:release": "tsx --test scripts/release/*.test.mjs scripts/release/*.test.ts",
    "test:harnesses": "node --test crates/net/tests/runner.test.mjs scripts/hooks/*.test.mjs",
    "test:scripts": "tsx --test scripts/checks/*.test.mjs scripts/checks/*.test.ts scripts/dev/*.test.ts scripts/hooks/*.test.ts scripts/openvm/*.test.mjs",
    "build:circuits": "cargo run --quiet --locked -p e3-zk-build --",
    "rust:build:circuits": "cargo build --locked -p e3-zk-build",
    "test:circuit-build": "cargo test --locked -p e3-zk-build",
    "bench:circuits": "cargo run --locked --release -p e3-zk-benchmarks --",
    "test:circuit-bench": "cargo test --locked -p e3-zk-benchmarks",
    "generate:verifiers": "tsx scripts/circuits/verifiers.ts --circuits dkg_aggregator,decryption_aggregator",
    "store:circuits": "tsx scripts/circuits/artifacts.ts",
    "clean": "tsx scripts/dev/clean.ts",
    "compile": "pnpm build:ts && pnpm rust:build",
    "lint": "eslint . && pnpm evm:lint && pnpm rust:lint && pnpm noir:lint",
    "format": "prettier --write \"**/*.{js,jsx,mjs,cjs,json,md,mdx,ts,tsx,yml,yaml,css,sol}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,mjs,cjs,json,md,mdx,ts,tsx,yml,yaml,css,sol}\"",
    "check:license": "./scripts/checks/license-headers.sh",
    "check:pnpm": "./scripts/checks/pnpm.sh",
    "check:committee": "./scripts/checks/committee.sh",
    "check:addresses": "tsx scripts/checks/addresses.ts",
    "check:bindings": "tsx scripts/checks/cli-bindings.ts",
    "check:repository": "./scripts/checks/repository.sh",
    "check:shell": "node scripts/checks/shell-syntax.mjs",
    "check:links": "node scripts/checks/doc-links.mjs",
    "provenance:manifest": "tsx scripts/openvm/provenance.ts",
    "check:verifiers": "tsx scripts/circuits/verifiers.ts --circuits dkg_aggregator,decryption_aggregator --check",
    "test:circuit-tooling": "tsx --test scripts/circuits/artifacts.test.ts scripts/circuits/verifiers.test.ts",
    "test": "pnpm evm:test && pnpm rust:test && pnpm rust:test:slashing && pnpm rust:test:proofs && pnpm sdk:test && pnpm sdk:test:proofs:prepared && pnpm noir:test",
    "test:integration": "cd ./tests/integration && ./test.sh",
    "coverage": "pnpm evm:coverage",
    "prepare": "husky",
    "interfold": "cd crates && ./scripts/launch.sh",
    "rust:lint": "cargo fmt -- --check",
    "rust:format": "cargo fmt",
    "rust:clippy": "cargo clippy --locked",
    "ciphernode:add": "cd packages/interfold-contracts && pnpm ciphernode:admin-add",
    "ciphernode:remove": "cd packages/interfold-contracts && pnpm ciphernode:remove",
    "rust:test": "cd crates && ./scripts/test.sh",
    "rust:test:proofs": "cargo test --locked -p e3-zk-prover --test fold_accumulators_e2e_tests --test node_fold_correlated_e2e_tests -- --include-ignored --nocapture --test-threads=1",
    "rust:test:slashing": "cargo test --locked -p e3-zk-prover --test slashing_integration_tests -- --include-ignored --nocapture --test-threads=1",
    "noir:test": "./scripts/circuits/test.sh",
    "noir:lint": "./scripts/circuits/lint.sh",
    "rust:build": "cargo build --locked --release",
    "prerust:build": "pnpm evm:build && pnpm fixtures:build",
    "committee:new": "cd packages/interfold-contracts && pnpm committee:new",
    "committee:get-public-key": "cd packages/interfold-contracts && pnpm committee:get-public-key",
    "committee:get-active-aggregator": "cd packages/interfold-contracts && pnpm committee:get-active-aggregator",
    "committee:publish": "cd packages/interfold-contracts && pnpm hardhat committee:publish",
    "e3:activate": "cd packages/interfold-contracts && pnpm e3:activate",
    "e3-program:publishInput": "cd packages/interfold-contracts && pnpm hardhat e3-program:publishInput",
    "e3-program:setMockInterfold": "cd packages/interfold-contracts && pnpm hardhat e3-program:setMockInterfold",
    "e3:publishCiphertext": "cd packages/interfold-contracts && pnpm hardhat e3:publishCiphertext",
    "e3:get-plaintext": "cd packages/interfold-contracts && pnpm e3:get-plaintext",
    "evm:install": "cd packages/interfold-contracts && pnpm install",
    "evm:node": "cd packages/interfold-contracts && pnpm hardhat node",
    "evm:build": "cd packages/interfold-contracts && pnpm compile",
    "evm:lint": "cd packages/interfold-contracts && pnpm lint",
    "evm:test": "cd packages/interfold-contracts && pnpm test",
    "evm:deploy": "cd packages/interfold-contracts && pnpm run deploy:mocks",
    "evm:clean": "cd packages/interfold-contracts && pnpm clean:deployments",
    "evm:coverage": "cd packages/interfold-contracts && pnpm coverage",
    "evm:release": "cd packages/interfold-contracts && pnpm release",
    "mcp:build": "cd packages/interfold-mcp && pnpm build",
    "mcp:release": "cd packages/interfold-mcp && pnpm release",
    "react:build": "cd packages/interfold-react && pnpm build",
    "sdk:build": "cd packages/interfold-sdk && pnpm build",
    "sdk:test": "cd packages/interfold-sdk && pnpm test",
    "sdk:test:proofs": "cd packages/interfold-sdk && pnpm test:proofs",
    "sdk:test:proofs:prepared": "pnpm -C packages/interfold-sdk test:proofs:prepared",
    "sdk:release": "cd packages/interfold-sdk && pnpm release",
    "wasm:release": "cd crates/wasm && pnpm release",
    "config:release": "cd packages/interfold-config && pnpm release",
    "react:release": "cd packages/interfold-react && pnpm release",
    "npm:release": "pnpm build && pnpm config:release && pnpm evm:release && pnpm wasm:release && pnpm sdk:release && pnpm react:release && pnpm mcp:release",
    "openvm": "bash scripts/openvm/run.sh",
    "build": "pnpm compile",
    "fixtures:build": "cd crates/evm-helpers && ./scripts/build_fixtures.sh && cd ../indexer && ./scripts/build_fixtures.sh",
    "wasm:build": "cd ./crates/wasm && pnpm build",
    "build:ts": "pnpm evm:build && pnpm sdk:build && pnpm react:build && pnpm mcp:build",
    "template:build": "cd templates/default && pnpm compile",
    "prepare-publish": "tsx .github/scripts/prepareForNpmPublishing.ts"
  },
  "packageManager": "pnpm@10.7.1+sha512.2d92c86b7928dc8284f53494fb4201f983da65f0fb4f0d40baafa5cf628fa31dae3e5968f12466f17df7e97310e30f343a648baea1b9b350685dafafffdf5808",
  "devDependencies": {
    "@interfold/config": "workspace:*",
    "@trivago/prettier-plugin-sort-imports": "^4.3.0",
    "@types/node": "22.7.5",
    "auto-changelog": "^2.5.0",
    "eslint": "^9.39.1",
    "glob": "^11.0.3",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.0",
    "prettier": "^3.1.1",
    "prettier-plugin-solidity": "^1.2.0",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "prompts": "^2.4.2",
    "tsx": "^4.20.3",
    "typescript": "5.8.3",
    "yaml": "2.8.2"
  },
  "pnpm": {
    "overrides": {
      "@nomicfoundation/hardhat-keystore": "3.0.3",
      "@types/node": "22.7.5",
      "tsup": "8.5.0",
      "typescript": "5.8.3",
      "undici-types": "6.19.8",
      "viem": "2.38.6"
    }
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,json,md,mdx,ts,tsx,yml,yaml,css,sol}": [
      "prettier --check"
    ]
  }
}
