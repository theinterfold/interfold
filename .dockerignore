# First ignore everything
*
**/*

# Then allow cargo workspace files
!Cargo.toml
!Cargo.lock
!crates/**/*
!examples/CRISP/program/**/*
# CRISP's OpenVM proving service (crates/support/Dockerfile) builds in the CRISP workspace.
!examples/CRISP/Cargo.toml
!examples/CRISP/Cargo.lock
!examples/CRISP/.interfold/support/**
!examples/CRISP/server/**/*
!examples/CRISP/crates/**/*
!packages/**/*
!package.json
!pnpm-workspace.yaml
!pnpm-lock.yaml
!rust-toolchain.toml
!**/*.sh

# Explicitly ignore build artifacts everywhere
target/
**/target/
**/.git/
**/.gitignore
**/.DS_Store
**/tests/tmp/
**/*.log

# Explicitly ignore node_modules
**/node_modules/
