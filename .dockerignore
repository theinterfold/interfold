# First ignore everything
*
**/*

# Then allow cargo workspace files
!Cargo.toml
!Cargo.lock
!crates/**/*
!packages/**/*
!package.json
!pnpm-workspace.yaml
!pnpm-lock.yaml
!rust-toolchain.toml
!**/*.sh

# Explicitly ignore build artifacts everywhere
target/
**/target/
**/.git/
**/.gitignore
**/.DS_Store
**/tests/tmp/
**/*.log

# Explicitly ignore node_modules
**/node_modules/

# Never send local secrets to an image: a checkout's .env files can hold deployment keys. These
# rules come last so that no allow rule above can bring a .env file back.
**/.env
**/.env.*
!**/.env.example
