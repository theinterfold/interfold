        },
        {
          "name": "ComputeRequest (ZkRequest::NodeDkgFold)",
          "by": "NodeProofAggregator",
          "ref": "crates/zk-prover/src/node_proof_aggregation/effects.rs@245@ZkRequest::NodeDkgFold(req)"
        },
        {
          "name": "DKGRecursiveAggregationComplete",
          "by": "NodeProofAggregator",
          "ref": "crates/zk-prover/src/node_proof_aggregation/effects.rs@31@DKGRecursiveAggregationComplete {"
