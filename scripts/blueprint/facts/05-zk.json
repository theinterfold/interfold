    {
      "id": "e3-zk-prover",
      "documentation": [
        { "title": "Proof statements", "path": "docs/architecture/proof-statements.md" },
        { "title": "Circuit artifacts", "path": "docs/architecture/circuit-artifacts.md" }
      ],
      "kind": "crate",
      "path": "crates/zk/prover",
      "one_line": "Turns proof requests into Noir/bb proofs, verifies other nodes' proofs, and folds DKG proofs recursively.",
      "actors": [
        {
          "name": "ZkActor",
          "role": "Serial verification adapter: runs bb verification through the node's shared task pool and replies with the outcome",
          "ref": "crates/zk/prover/src/zk_actor.rs@21@pub struct ZkActor"
        },
        {
          "name": "ProofRequestActor",
          "role": "Receives the *Pending triggers, publishes ComputeRequest jobs, and signs each returned proof; it never calls the prover itself",
          "ref": "crates/zk/prover/src/proof_request/actor.rs@67@pub struct ProofRequestActor"
        },
        {
          "name": "ProofVerificationActor",
          "role": "Checks a peer's BFV public key (C0): recovers the signer, asks ZkActor to verify, then emits pass or fail",
          "ref": "crates/zk/prover/src/proof_verification/actor.rs@72@pub struct ProofVerificationActor"
        },
        {
          "name": "ShareVerificationActor",
          "role": "Verifies peers' C1-C4 and C6 share proofs: ECDSA check, commitment consistency check, then ZK verification through ComputeRequest",
          "ref": "crates/zk/prover/src/share_verification/actor.rs@56@pub struct ShareVerificationActor"
        },
        {
          "name": "NodeProofAggregator",
          "role": "Buffers a node's inner DKG proofs and dispatches one NodeDkgFold fold when the share set is ready",
          "ref": "crates/zk/prover/src/node_proof_aggregation/actor.rs@32@pub struct NodeProofAggregator"
        }
      ],
      "consumes": [
        {
          "name": "EncryptionKeyPending",
          "by": "ProofRequestActor",
          "ref": "crates/zk/prover/src/proof_request/actor.rs@180@EventType::EncryptionKeyPending"
        },
        {
          "name": "ThresholdSharePending",
          "by": "ProofRequestActor",
          "ref": "crates/zk/prover/src/proof_request/actor.rs@183@EventType::ThresholdSharePending"
        },
        {
