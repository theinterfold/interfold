        {
          "name": "CommitmentConsistencyCheckRequested",
          "by": "ShareVerificationActor",
          "ref": "crates/zk-prover/src/share_verification/effects/ecdsa.rs@82@CommitmentConsistencyCheckRequested {"
        },
        {
          "name": "ShareVerificationComplete",
          "by": "ShareVerificationActor",
