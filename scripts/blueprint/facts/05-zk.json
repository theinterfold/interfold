          "ref": "crates/zk-prover/src/proof_request/actor.rs@187@EventType::AggregationProofPending"
        },
        {
          "name": "ComputeResponse",
          "by": "ProofRequestActor",
          "ref": "crates/zk-prover/src/proof_request/actor.rs@181@EventType::ComputeResponse"
        },
        {
          "name": "EncryptionKeyReceived",
