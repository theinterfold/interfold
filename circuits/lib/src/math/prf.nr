#[test]
fn fhe_v060_full_key_owner_3() {
    let ciphertext: [[[u64; 8]; 2]; 2] = [
        [
            [0, 65536, 32768, 32769, 4, 0, 65536, 32768],
            [0, 65520, 32760, 32761, 23, 0, 65520, 32760],
        ],
        [
            [0, 65536, 32768, 32769, 75, 0, 65536, 32768],
            [0, 65520, 32760, 32761, 94, 0, 65520, 32760],
        ],
    ];
    let outgoing: [[u8; 32]; 5] = [
        [
